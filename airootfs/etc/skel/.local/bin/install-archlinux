#!/usr/bin/env bash
# shellcheck disable=SC1091
#
# flash-install: partition, format and bootstrap Arch Linux onto a disk.
#
# Usage: flash-install <disk> <hostname>

set -euo pipefail

if [[ $# -ne 3 ]]; then
  echo "Usage: ${0##*/} <disk> <hostname> <username>" >&2
  exit 1
fi

# Re-run as root once, so individual commands don't each need sudo.
[[ $EUID -eq 0 ]] || exec sudo -- "$0" "$@"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "$SCRIPT_DIR/lib/logger.sh"

# --- Configuration -----------------------------------------------------------

readonly MOUNT_POINT="/mnt"

readonly BOOT_LABEL="ARCH"
readonly ROOT_LABEL="root"
readonly DATA_LABEL="data"

# Partition end offsets: boot ends at BOOT_END, root at ROOT_END, data takes the rest.
readonly BOOT_END="500MiB"
readonly ROOT_END="50GiB"

readonly BTRFS_OPTIONS="compress=zstd,noatime"
readonly MIRROR_COUNTRIES="Kenya,South Africa"

readonly PACKAGES=(base linux linux-firmware)
readonly ROOT_SUBVOLUMES=(@ @home @var_cache @var_log)
readonly DATA_SUBVOLUMES=(@data @data_appdata @data_downloads @data_media)

readonly CONFIGURE_SCRIPT="configure.sh"

# Set in main() / resolve_partitions().
DISK=""
TARGET_HOSTNAME=""
USERNAME=""
BOOT_PARTITION=""
ROOT_PARTITION=""
DATA_PARTITION=""

# --- Helpers -----------------------------------------------------------------

die() {
  log_error "$1"
  exit 1
}

# create_subvolumes <partition> <name>...
# Mounts the partition, creates each subvolume, then unmounts it again.
create_subvolumes() {
  local partition=$1 name
  shift

  log_step "Creating subvolumes on $partition"
  mount "$partition" "$MOUNT_POINT"
  for name in "$@"; do
    btrfs subvolume create "$MOUNT_POINT/$name"
  done
  umount "$MOUNT_POINT"
}

# mount_subvolume <partition> <subvolume> <target-relative-to-mount-point>
mount_subvolume() {
  mount --mkdir --options "$BTRFS_OPTIONS,subvol=$2" "$1" "$MOUNT_POINT$3"
}

# --- Pre-install -------------------------------------------------------------

check_internet() {
  log_step "Checking internet connection"

  ping -c1 -W2 ping.archlinux.org &>/dev/null ||
    die "There's no internet connection. Run 'sudo nmtui'."
}

check_clock() {
  log_step "Updating the system clock"
  echo
  timedatectl
  echo
}

check_disk() {
  [[ -b $DISK ]] || die "$DISK does not exist. Check 'lsblk'."
}

confirm_wipe() {
  log_warning "About to WIPE $DISK"
  echo
  lsblk "$DISK"
  echo
  confirm "Type 'yes' to continue:" || die "Aborted"
  echo
}

partition_disk() {
  log_step "Partitioning $DISK"

  parted --script "$DISK" \
    mklabel gpt \
    mkpart "$BOOT_LABEL" fat32 1MiB "$BOOT_END" \
    set 1 esp on \
    mkpart "$ROOT_LABEL" btrfs "$BOOT_END" "$ROOT_END" \
    mkpart "$DATA_LABEL" btrfs "$ROOT_END" 100%

  partprobe "$DISK"
  udevadm settle
}

# Disks whose name ends in a digit (nvme0n1, mmcblk0, loop0) use a "p" separator.
resolve_partitions() {
  local prefix=$DISK

  if [[ $DISK == *[0-9] ]]; then
    prefix+="p"
  fi

  BOOT_PARTITION="${prefix}1"
  ROOT_PARTITION="${prefix}2"
  DATA_PARTITION="${prefix}3"
}

format_partitions() {
  log_step "Formatting partitions"

  mkfs.fat -F32 -n "$BOOT_LABEL" "$BOOT_PARTITION" >/dev/null
  mkfs.btrfs --force --quiet --label "$ROOT_LABEL" "$ROOT_PARTITION"
  mkfs.btrfs --force --quiet --label "$DATA_LABEL" "$DATA_PARTITION"
}

mount_filesystems() {
  log_step "Mounting file systems"

  create_subvolumes "$ROOT_PARTITION" "${ROOT_SUBVOLUMES[@]}"
  create_subvolumes "$DATA_PARTITION" "${DATA_SUBVOLUMES[@]}"

  log_step "Mounting btrfs subvolumes with options"

  # Parents must be mounted before their children.
  mount_subvolume "$ROOT_PARTITION" @ ""
  mount_subvolume "$ROOT_PARTITION" @home /home
  mount_subvolume "$ROOT_PARTITION" @var_cache /var/cache
  mount_subvolume "$ROOT_PARTITION" @var_log /var/log
  mount_subvolume "$DATA_PARTITION" @data /data
  mount_subvolume "$DATA_PARTITION" @data_appdata /data/appdata
  mount_subvolume "$DATA_PARTITION" @data_downloads /data/downloads
  mount_subvolume "$DATA_PARTITION" @data_media /data/media

  log_step "Mounting boot partition"
  mount --mkdir "$BOOT_PARTITION" "$MOUNT_POINT/boot"
  echo
}

# --- Installation ------------------------------------------------------------

install_base() {
  log_info "INSTALLATION"

  log_step "Selecting mirrors"
  reflector \
    --connection-timeout 60 \
    --download-timeout 60 \
    --country "$MIRROR_COUNTRIES" \
    --latest 10 \
    --protocol https \
    --sort rate \
    --save /etc/pacman.d/mirrorlist

  log_step "Installing packages"
  pacstrap -K "$MOUNT_POINT" "${PACKAGES[@]}"
  echo
}

# --- System configuration ----------------------------------------------------

configure_system() {
  log_info "SYSTEM CONFIGURATION"

  log_step "Generating fstab"
  genfstab -U "$MOUNT_POINT" | tee --append "$MOUNT_POINT/etc/fstab"

  log_step "Chrooting into the new environment"
  install -m 755 "$SCRIPT_DIR/$CONFIGURE_SCRIPT" "$MOUNT_POINT/root/$CONFIGURE_SCRIPT"
  arch-chroot -S "$MOUNT_POINT" "/root/$CONFIGURE_SCRIPT" "$TARGET_HOSTNAME" "$USERNAME"
  rm -f "$MOUNT_POINT/root/$CONFIGURE_SCRIPT"

  umount --force --recursive "$MOUNT_POINT"
}

# --- Main --------------------------------------------------------------------

main() {
  DISK=$1
  TARGET_HOSTNAME=$2
  USERNAME=$3

  log_info "PRE-INSTALL"
  check_internet
  check_clock
  check_disk
  confirm_wipe

  partition_disk
  resolve_partitions
  format_partitions
  mount_filesystems

  install_base
  configure_system

  log_info "Completed setup. Reboot to log into the new system"
}

main "$@"
